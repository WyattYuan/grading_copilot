# OpenAI API 配置（如果使用 OpenAI）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# 阿里云 DashScope API 配置（如果使用通义千问）
# 支持的模型: qwen-plus, qwen-max, qwen-turbo, qwen2.5-72b-instruct
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# OPENAI_MODEL=qwen-plus

# FastAPI 配置
API_HOST=127.0.0.1
API_PORT=8499

# Streamlit 配置
STREAMLIT_PORT=8501

# 数据存储路径
DATA_DIR=./data
UPLOADS_DIR=./data/uploads
REPORTS_DIR=./data/reports
